{
  "title": "Relay crank turner",
  "uid": "relay-crank-turner",
  "tags": [
    "relay",
    "solana",
    "keeper"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "editable": true,
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Load \u2014 what is being evaluated",
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Evaluations by wake kind",
      "description": "Every condition looked at, per second, whether or not anything came of it. This is the load metric: if the turner is busy, this says what is making it busy. A tight EverySlots wake or a change-wake on a hot account costs a resolve simulation every time it fires, so a spike here with no matching rise in 'Cranks sent' is wasted work \u2014 the fix is in the target program's wake hints.",
      "id": 2,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (wake) (rate(relay_evaluations_total[$__rate_interval]))",
          "legendFormat": "{{wake}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          },
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Evaluations by program",
      "description": "The same load, attributed. This is the panel for 'who is spamming me' when the registry is shared between protocols \u2014 pair it with --target-program to stop paying for another protocol's watches.",
