          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, program) (rate(relay_due_per_tick_bucket[$__rate_interval])))",
          "legendFormat": "p99 due {{program}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(rate(relay_saturated_ticks_total[$__rate_interval]))",
          "legendFormat": "saturated ticks/s",
          "range": true,
          "refId": "A"
        }
