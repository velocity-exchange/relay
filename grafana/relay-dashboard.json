          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, stage, program) (rate(relay_stage_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{stage}} {{program}}",
          "range": true,
          "refId": "A"
        }
      ],
