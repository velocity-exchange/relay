    {
      "type": "timeseries",
      "title": "Conditions due per tick (p99) vs saturation",
      "description": "The clearest saturation signal in the whole dashboard. While 'saturated ticks' is above zero, more conditions were due than could run at once and work is waiting on --concurrency rather than on the chain. Raising concurrency is the fix, up to the point where RPC latency becomes the limit instead.",
      "id": 9,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
