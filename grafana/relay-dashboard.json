    {
      "type": "timeseries",
      "title": "Contention delay (slots)",
      "description": "Slots this turner is deliberately holding cranks back by, because that program's transactions keep reverting. Nonzero means a rival is winning; pinned at the ceiling means it is winning consistently. It decays as cranks start landing again, so a sawtooth is healthy adaptation and a flat line at the ceiling is not.",
      "id": 15,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
