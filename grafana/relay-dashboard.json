    {
      "type": "timeseries",
      "title": "Skips by reason",
      "description": "not_due and backoff are the healthy baseline and will dominate. The ones that matter are the ones that should be flat zero: executor_named_signer means a target program tried to take the keeper's signature, parse_failed means a condition block stopped being readable, no_safe_payout means an untrusted program has nowhere to pay. contention_delay rising means a rival turner is winning races.",
      "id": 4,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum by (reason) (rate(relay_skips_total[$__rate_interval]))",
          "legendFormat": "{{reason}}",
          "range": true,
          "refId": "A"
