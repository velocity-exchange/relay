    {
      "type": "timeseries",
      "title": "Tick duration (p99 / p50)",
      "description": "The top-level answer to 'is the turner keeping up'. Compare total against --tick-ms: if total approaches the tick interval, ticks are running back to back and everything is late. decide is pure CPU over cached state; execute covers resolve, build, simulate and submit for every due condition concurrently.",
      "id": 7,
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, phase) (rate(relay_tick_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{phase}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, phase) (rate(relay_tick_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{phase}}",
          "range": true,
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "showPoints": "never",
            "lineWidth": 1,
            "stacking": {
              "mode": "none"
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Stage duration p99 (per condition)",
      "description": "Per condition rather than per tick, so one expensive resolver is visible instead of averaged away. Local simulation should be sub-millisecond; anything past ~50ms means it is reaching the network, which usually means the accounts it needs are not covered by a --watch-program.",
